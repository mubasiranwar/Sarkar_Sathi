# Sarkar Sathi — Qwen API Configuration
# Copy this file to .env.local and fill in your values

# ModelScope Access Token (get yours at https://modelscope.ai/my/access/token)
QWEN_API_KEY=your-modelscope-access-token-here

# Qwen Model (default: Qwen/Qwen3-Max)
QWEN_MODEL=Qwen/Qwen3-Max

# ModelScope API Base URL (OpenAI-compatible endpoint)
# International: https://api-inference.modelscope.ai/v1
# China:         https://api-inference.modelscope.cn/v1
QWEN_BASE_URL=https://api-inference.modelscope.ai/v1
